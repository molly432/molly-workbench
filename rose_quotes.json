{
  "meta": {
    "name": "玫瑰开场 · 每日一句",
    "version": 1,
    "note": "字段：t=正文 a=作者 w=出处 k=类别。全部为公共领域的经典引用 / 广为流传的名人原话。想加句子直接往 quotes 里追加即可，重跑 add_splash.py 生效。"
  },
  "quotes": [
    { "t": "仅仅凭借锲而不舍的意志力，你就可以让世界精疲力尽，把你想要的东西给你。", "a": "苏世民", "w": "《我的经验与教训》", "k": "坚持" },
    { "t": "那些杀不死我的，使我更强大。", "a": "尼采", "w": "《偶像的黄昏》", "k": "坚持" },
    { "t": "在隆冬，我终于知道，我身上有一个不可战胜的夏天。", "a": "加缪", "w": "《夏》", "k": "心性" },
    { "t": "世界上只有一种英雄主义，就是看清生活的真相之后，依然热爱生活。", "a": "罗曼·罗兰", "w": "《米开朗基罗传》", "k": "勇气" },
    { "t": "一个人可以被毁灭，但不能被打败。", "a": "海明威", "w": "《老人与海》", "k": "坚持" },
    { "t": "世界打垮每一个人，但在许多地方，许多人后来变得更坚强。", "a": "海明威", "w": "《永别了，武器》", "k": "坚持" },
    { "t": "我只怕一件事：配不上自己所受的苦难。", "a": "陀思妥耶夫斯基", "w": "《卡拉马佐夫兄弟》", "k": "担当" },
    { "t": "使沙漠显得美丽的，是它在某个地方藏着一口井。", "a": "圣埃克苏佩里", "w": "《小王子》", "k": "远见" },
    { "t": "生活不是我们活过的日子，而是我们记住的日子。", "a": "马尔克斯", "w": "《活着为了讲述》", "k": "时间" },
    { "t": "走自己的路，让别人去说吧。", "a": "但丁", "w": "《神曲》", "k": "勇气" },
    { "t": "凡是自强不息者，终能得救。", "a": "歌德", "w": "《浮士德》", "k": "坚持" },
    { "t": "自由是上天赐予人类最珍贵的礼物之一。", "a": "塞万提斯", "w": "《堂吉诃德》", "k": "心性" },
    { "t": "如果你因失去了太阳而流泪，那么你也将失去群星了。", "a": "泰戈尔", "w": "《飞鸟集》", "k": "心性" },
    { "t": "让生如夏花之绚烂，死如秋叶之静美。", "a": "泰戈尔", "w": "《飞鸟集》", "k": "心性" },
    { "t": "你的痛楚，是打破包裹你认知的那层外壳。", "a": "纪伯伦", "w": "《先知》", "k": "心性" },
    { "t": "要对一切尚未解决的事保持耐心，要学会热爱提问本身。", "a": "里尔克", "w": "《给一个青年诗人的信》", "k": "心性" },
    { "t": "他们能，因为他们相信自己能。", "a": "维吉尔", "w": "《埃涅阿斯纪》", "k": "勇气" },
    { "t": "你拥有支配自己心灵的力量，而不受外物支配。", "a": "马可·奥勒留", "w": "《沉思录》", "k": "心性" },
    { "t": "困扰人们的不是事物本身，而是他们对事物的看法。", "a": "爱比克泰德", "w": "《手册》", "k": "心性" },
    { "t": "不是我们拥有的时间太少，而是我们浪费的太多。", "a": "塞内加", "w": "《论生命之短暂》", "k": "时间" },
    { "t": "你只有行动的权利，而无权占有行动的果实。", "a": "《薄伽梵歌》", "w": "第二章", "k": "行动" },
    { "t": "顺境的美德是节制，逆境的美德是坚忍。", "a": "培根", "w": "《论厄运》", "k": "心性" },
    { "t": "效率是把事情做对，效能是做对的事情。", "a": "彼得·德鲁克", "w": "《卓有成效的管理者》", "k": "行动" },
    { "t": "要得到你想要的东西，最可靠的办法是让自己配得上它。", "a": "查理·芒格", "w": "《穷查理宝典》", "k": "心性" },
    { "t": "人生的道路，都是由心来描绘的。", "a": "稻盛和夫", "w": "《活法》", "k": "心性" },
    { "t": "不做准备，就是在准备失败。", "a": "富兰克林", "w": "《穷理查年鉴》", "k": "行动" },
    { "t": "你的时间有限，不要把它浪费在重复别人的生活上。", "a": "乔布斯", "w": "2005 年斯坦福演讲", "k": "时间" },
    { "t": "成功不是终点，失败不是终结，唯有继续前行的勇气才是永恒。", "a": "丘吉尔", "w": "演讲", "k": "坚持" },
    { "t": "我们唯一值得恐惧的，是恐惧本身。", "a": "罗斯福", "w": "1933 年就职演说", "k": "勇气" },
    { "t": "事情在成功之前，看起来总是那么难。", "a": "曼德拉", "w": "《漫漫自由路》", "k": "坚持" },
    { "t": "衡量一个人的最终标准，不是他在安逸时的立场，而是他在挑战中的立场。", "a": "马丁·路德·金", "w": "《爱的力量》", "k": "担当" },
    { "t": "我要扼住命运的咽喉，它绝不能使我完全屈服。", "a": "贝多芬", "w": "书信", "k": "坚持" },
    { "t": "并不是我很聪明，只是我和问题相处得更久一些。", "a": "爱因斯坦", "w": "访谈", "k": "心性" },
    { "t": "生活中没有什么可怕的东西，只有需要理解的东西。", "a": "居里夫人", "w": "演讲", "k": "心性" },
    { "t": "人须在事上磨，方立得住。", "a": "王阳明", "w": "《传习录》", "k": "行动" },
    { "t": "天行健，君子以自强不息。", "a": "《周易》", "w": "乾卦", "k": "坚持" },
    { "t": "士不可以不弘毅，任重而道远。", "a": "《论语》", "w": "泰伯篇", "k": "担当" },
    { "t": "人固有一死，或重于泰山，或轻于鸿毛。", "a": "司马迁", "w": "《报任安书》", "k": "担当" },
    { "t": "老骥伏枥，志在千里；烈士暮年，壮心不已。", "a": "曹操", "w": "《龟虽寿》", "k": "远见" },
    { "t": "古之立大事者，不惟有超世之才，亦必有坚忍不拔之志。", "a": "苏轼", "w": "《晁错论》", "k": "坚持" },
    { "t": "天下事，在局外呐喊议论，总是无益，必须躬身入局。", "a": "曾国藩", "w": "《曾国藩家书》", "k": "行动" },
    { "t": "千里之行，始于足下。", "a": "《老子》", "w": "第六十四章", "k": "累积" },
    { "t": "天下难事，必作于易；天下大事，必作于细。", "a": "《老子》", "w": "第六十三章", "k": "行动" },
    { "t": "投之亡地然后存，陷之死地然后生。", "a": "《孙子兵法》", "w": "九地篇", "k": "勇气" },
    { "t": "红日初升，其道大光。", "a": "梁启超", "w": "《少年中国说》", "k": "担当" },
    { "t": "路漫漫其修远兮，吾将上下而求索。", "a": "屈原", "w": "《离骚》", "k": "坚持" },
    { "t": "纸上得来终觉浅，绝知此事要躬行。", "a": "陆游", "w": "《冬夜读书示子聿》", "k": "行动" },
    { "t": "天将降大任于是人也，必先苦其心志，劳其筋骨。", "a": "《孟子》", "w": "告子下", "k": "坚持" },
    { "t": "愿中国青年都摆脱冷气，只是向上走，不必听自暴自弃者流的话。", "a": "鲁迅", "w": "《热风》", "k": "担当" },
    { "t": "宠辱不惊，闲看庭前花开花落；去留无意，漫随天外云卷云舒。", "a": "《菜根谭》", "w": "闲适篇", "k": "心性" },
    { "t": "穷且益坚，不坠青云之志。", "a": "王勃", "w": "《滕王阁序》", "k": "坚持" },
    { "t": "长风破浪会有时，直挂云帆济沧海。", "a": "李白", "w": "《行路难》", "k": "远见" },
    { "t": "千磨万击还坚劲，任尔东西南北风。", "a": "郑板桥", "w": "《竹石》", "k": "坚持" },
    { "t": "粉骨碎身浑不怕，要留清白在人间。", "a": "于谦", "w": "《石灰吟》", "k": "心性" },
    { "t": "尽吾志也而不能至者，可以无悔矣。", "a": "王安石", "w": "《游褒禅山记》", "k": "行动" },
    { "t": "会当凌绝顶，一览众山小。", "a": "杜甫", "w": "《望岳》", "k": "远见" },
    { "t": "为天地立心，为生民立命，为往圣继绝学，为万世开太平。", "a": "张载", "w": "《横渠语录》", "k": "担当" },
    { "t": "大寒既至，霜雪既降，吾是以知松柏之茂也。", "a": "《淮南子》", "w": "俶真训", "k": "坚持" },
    { "t": "非淡泊无以明志，非宁静无以致远。", "a": "诸葛亮", "w": "《诫子书》", "k": "心性" },
    { "t": "苟利国家生死以，岂因祸福避趋之。", "a": "林则徐", "w": "《赴戍登程口占示家人》", "k": "担当" },
    { "t": "业精于勤，荒于嬉；行成于思，毁于随。", "a": "韩愈", "w": "《进学解》", "k": "行动" }
  ]
}
